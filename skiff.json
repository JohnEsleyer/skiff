{
  "id": "esper-prod",
  "name": "Esper Backend",
  "localPath": ".",
  "serverId": "vps-main",
  "appDir": "/opt/skiff/apps/esper",
  "domain": "api.esper.yourdomain.com",
  "targetPort": 8080,
  "tlsMode": "auto",
  "buildSteps": [
    {
      "name": "Rust Backend (musl static binary)",
      "command": "cargo build --manifest-path server/Cargo.toml --release --target x86_64-unknown-linux-musl"
    }
  ],
  "artifacts": [
    {
      "local": "server/target/x86_64-unknown-linux-musl/release/esper-server",
      "remote": "esper-server"
    },
    {
      "local": "server/src/schema.surql",
      "remote": "schema.surql"
    },
    {
      "local": "setup.sh",
      "remote": "setup.sh"
    }
  ],
  "remoteSetupSteps": [
    {
      "name": "Initialize Environment & SurrealDB Schema",
      "command": "bash setup.sh"
    }
  ],
  "sharedFiles": [
    ".env",
    "uploads"
  ],
  "restartCommand": "sudo systemctl restart esper-server && sudo systemctl reload caddy",
  "healthUrl": "http://127.0.0.1:8080/api/health",
  "keepReleases": 3
}
